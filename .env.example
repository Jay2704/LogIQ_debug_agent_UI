# Copy to `.env` or `.env.local` and adjust. Vite reads these at dev/build startup only —
# restart `npm run dev` after any change here so variables reload.

# VITE_USE_HTTP=true
# VITE_API_BASE_URL=http://127.0.0.1:8000

# GitHub Pages build (set automatically in deploy workflow):
# VITE_BASE_PATH=/LogIQ_debug_agent_UI/

# Temporary conference demo — bypasses login (remove or set false after demo):
# VITE_DEMO_MODE=true

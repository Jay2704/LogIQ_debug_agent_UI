# LogIQ Debug Agent UI — copy to `.env` or `.env.local` in this repo root.
# Restart `npm run dev` after changes. Only `VITE_*` vars are exposed to the client.

# Backend origin only (scheme + host [+ port]). No path suffix.
# Examples: https://api.yourcompany.com   or   http://localhost:8000 (local backend port as you run it)
VITE_API_BASE_URL=

# Set to `true` to use the real HTTP client for supported routes (requires VITE_API_BASE_URL).
# Any other value or unset → in-memory mock data for supported routes.
VITE_USE_HTTP=true

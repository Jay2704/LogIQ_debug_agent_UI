# Copy to `.env` or `.env.local` and adjust. Vite reads these at dev/build startup only —
# restart `npm run dev` after any change here so variables reload.
#
# Login needs BOTH:
#   1) Frontend: npm run dev  (or npm run dev:stack)
#   2) Backend:  uvicorn in ../log-analysis-AI-agent on port 8000
# "Could not reach the API" means the backend is not running — the UI config did not change.

VITE_USE_HTTP=true
VITE_API_BASE_URL=http://127.0.0.1:8000

# MCP investigation context preview (RCA workflow only):
# VITE_MCP_UI_ENABLED=true

# GitHub Pages build (set automatically in deploy workflow):
# VITE_BASE_PATH=/LogIQ_debug_agent_UI/
